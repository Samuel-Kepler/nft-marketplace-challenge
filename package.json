{
  "name": "nft-marketplace",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode mocks",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "playwright test --project=unit",
    "test:integration": "playwright test --project=integration",
    "test:e2e": "playwright test --project=desktop --project=mobile --project=tablet",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "audit:lighthouse": "lhci autorun"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@tanstack/react-router": "^1.91.3",
    "@tanstack/react-query": "^5.62.7",
    "axios": "^1.7.9",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "zod": "^3.24.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7",
    "typescript": "^5.7.3",
    "@tanstack/router-plugin": "^1.91.3",
    "msw": "^2.7.0",
    "@mswjs/socket.io-binding": "^0.2.0",
    "@playwright/test": "^1.49.1",
    "@lhci/cli": "^0.15.0",
    "eslint": "^9.18.0",
    "typescript-eslint": "^8.19.1",
    "eslint-plugin-react-hooks": "^5.1.0"
  }
}
