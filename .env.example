# Copie este arquivo para ".env" e preencha os valores.
# NUNCA faça commit do ".env" (ele já está no .gitignore).

# --- Scripts de orquestração em Python (orchestrator*.py, final_audit.py) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=
# Teto de tokens estimados por sessão (trava de segurança do orchestrator.py)
MAX_BUDGET_TOKENS_SESSAO=60000

# --- Front-end (Vite) ---
# Já definidos em .env.development, .env.mocks e .env.production (sem segredos).
# VITE_ENABLE_MOCKS=true
